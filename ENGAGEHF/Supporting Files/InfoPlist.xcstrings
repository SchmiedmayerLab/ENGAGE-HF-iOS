    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ENGAGE-HF uses Bluetooth to connect to your blood pressure cuff and weight scale and to record the measurements you take."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ENGAGE-HF usa Bluetooth para conectarse a su tensiómetro y su báscula y registrar las mediciones que realice."
          }
        }
      }
    },
